@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix acttype: <https://w3id.org/ogc/rim/activity-type/> .
@prefix rim:     <https://w3id.org/ogc/rim/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .

# Constrained profile shapes: an acttype:ActivityType is still a
# rim:RegisterItem, so rim:RegisterItemShape (identifiers, statuses, item
# class) continues to apply. These shapes add the restriction that makes
# the register an activity type register, in both directions:
#
#   - every acttype:ActivityType uses acttype:activityTypeItemClass as its
#     rim:itemClass, and is a sub-class of prov:Activity;
#   - every register item whose rim:itemClass is acttype:activityTypeItemClass
#     is an acttype:ActivityType (i.e. the domain of rim:itemClass, for this
#     item class, is narrowed to types of prov:Activity).
#
# The rdfs:subClassOf chain up to prov:Activity must be present in the
# data graph (or its ontology closure) — for a type that specialises
# another registered type, that type's own ontology supplies the rest of
# the chain.

acttype:ActivityTypeShape a sh:NodeShape ;
    sh:targetClass acttype:ActivityType ;
    sh:property [
        sh:path rim:itemClass ;
        sh:hasValue acttype:activityTypeItemClass ;
        sh:message "An activity type's rim:itemClass must be acttype:activityTypeItemClass." ;
    ] ;
    sh:property [
        sh:path [ sh:oneOrMorePath rdfs:subClassOf ] ;
        sh:hasValue prov:Activity ;
        sh:message "An activity type must be a sub-class (directly or indirectly) of prov:Activity." ;
    ] ;
    sh:property [ sh:path acttype:usedEntityType ;         sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path acttype:generatedEntityType ;    sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path acttype:associatedAgentType ;    sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path acttype:informedByActivityType ; sh:nodeKind sh:IRI ] ;
    sh:property [
        sh:path acttype:plan ;
        sh:class prov:Plan ;
        sh:maxCount 1 ;
    ] .

acttype:ActivityTypeItemClassShape a sh:NodeShape ;
    sh:targetNode acttype:activityTypeItemClass ;
    sh:property [
        sh:path [ sh:inversePath rim:itemClass ] ;
        sh:class acttype:ActivityType ;
        sh:message "Every register item of item class acttype:activityTypeItemClass must be an acttype:ActivityType." ;
    ] .
