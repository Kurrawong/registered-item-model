@prefix acttype: <https://w3id.org/ogc/rim/activity-type/> .
@prefix rim:     <https://w3id.org/ogc/rim/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix dct:     <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .

#################################################################
# Ontology Metadata
#
# A profile of the Registered Item Model (rim:) for registers whose items
# are types of prov:Activity. Each register item is itself a class — a
# sub-class of prov:Activity — so the governed thing (the register item,
# with its identifiers, statuses and actions) and the type that activity
# instances are declared with (rdf:type) are one and the same resource.
#################################################################

acttype: a owl:Ontology ;
    owl:imports rim: ;
    dct:title "Activity Type Register Profile" ;
    dct:description "A profile of the Registered Item Model for registers of prov:Activity types. Restricts the register items of such a register to classes that specialise prov:Activity, lets each type declare the types of PROV entities, agents and activities it relates to, and optionally a prov:Plan describing its required steps. Further profiles specialise both the activity types and those related types." ;
    dct:creator "Rob Atkinson, OGC" ;
    dct:license <https://creativecommons.org/publicdomain/zero/1.0/> .

#################################################################
# The activity type as a register item
#
# acttype:ActivityType is a metaclass: its instances are classes, each a
# sub-class (directly or indirectly) of prov:Activity (OWL 2 punning).
# It narrows the domain of rim:itemClass for this kind of register: every
# register item carrying acttype:activityTypeItemClass must be an
# acttype:ActivityType, and so a type of prov:Activity. Both directions
# are enforced in shapes.shacl.
#################################################################

acttype:ActivityType a owl:Class ;
    rdfs:subClassOf rim:RegisterItem ;
    rdfs:isDefinedBy acttype: ;
    rdfs:label "Activity type" ;
    rdfs:comment "A register item that is a type of prov:Activity: a class, declared rdfs:subClassOf prov:Activity (directly or via other registered activity types), whose instances are individual activities. Being a rim:RegisterItem, the type itself carries identifiers, validity and publication status, and a governed change history." .

acttype:activityTypeItemClass a rim:RegisterItemClass ;
    rdfs:isDefinedBy acttype: ;
    dct:title "Activity type" ;
    dct:description "The register item class of every item in an activity type register. Items of this class must be acttype:ActivityType instances, i.e. sub-classes of prov:Activity." ;
    rim:validatedBy acttype:ActivityTypeShape .

#################################################################
# Related PROV object types
#
# Type-level counterparts of the instance-level PROV relations: they say
# which kinds of entity an activity of this type uses and generates,
# which kinds of agent it is associated with, and which kinds of activity
# inform it. They are plain properties rather than OWL restrictions so
# that any register's own schema can map onto them with a JSON-LD
# context, and so that further profiles can constrain their values with
# SHACL (see the README for the pattern). Values are classes; the
# corresponding instance-level PROV property is given by rdfs:seeAlso.
#################################################################

acttype:usedEntityType a owl:ObjectProperty ;
    rdfs:isDefinedBy acttype: ;
    rdfs:label "used entity type" ;
    rdfs:comment "A type of prov:Entity that activities of this type use (prov:used) — for example a type of input dataset." ;
    rdfs:seeAlso prov:used ;
    rdfs:domain acttype:ActivityType ;
    rdfs:range owl:Class .

acttype:generatedEntityType a owl:ObjectProperty ;
    rdfs:isDefinedBy acttype: ;
    rdfs:label "generated entity type" ;
    rdfs:comment "A type of prov:Entity that activities of this type generate (prov:generated) — for example a type of output product." ;
    rdfs:seeAlso prov:generated ;
    rdfs:domain acttype:ActivityType ;
    rdfs:range owl:Class .

acttype:associatedAgentType a owl:ObjectProperty ;
    rdfs:isDefinedBy acttype: ;
    rdfs:label "associated agent type" ;
    rdfs:comment "A type of prov:Agent (for example prov:Person, prov:SoftwareAgent, or a narrower role-bearing type) that activities of this type are associated with (prov:wasAssociatedWith)." ;
    rdfs:seeAlso prov:wasAssociatedWith ;
    rdfs:domain acttype:ActivityType ;
    rdfs:range owl:Class .

acttype:informedByActivityType a owl:ObjectProperty ;
    rdfs:isDefinedBy acttype: ;
    rdfs:label "informed by activity type" ;
    rdfs:comment "A type of prov:Activity whose instances typically inform activities of this type (prov:wasInformedBy) — for example an upstream preparation activity type." ;
    rdfs:seeAlso prov:wasInformedBy ;
    rdfs:domain acttype:ActivityType ;
    rdfs:range owl:Class .

#################################################################
# Plan
#
# An activity type may point to one prov:Plan describing the steps an
# activity of that type is required to carry out. P-Plan
# (http://purl.org/net/p-plan#) is the recommended vocabulary for the
# steps themselves: p-plan:Plan is a sub-class of prov:Plan, with
# p-plan:Step, p-plan:isStepOfPlan and p-plan:isPrecededBy. At instance
# level, an activity records that it followed the plan with PROV's own
# qualified association (prov:qualifiedAssociation / prov:hadPlan) and
# p-plan:correspondsToStep.
#################################################################

acttype:plan a owl:ObjectProperty ;
    rdfs:isDefinedBy acttype: ;
    rdfs:label "plan" ;
    rdfs:comment "The prov:Plan describing the required steps of activities of this type. Optional; at most one." ;
    rdfs:seeAlso prov:hadPlan ;
    rdfs:domain acttype:ActivityType ;
    rdfs:range prov:Plan .
