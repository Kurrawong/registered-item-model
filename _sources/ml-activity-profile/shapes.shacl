@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix mlact: <https://w3id.org/ogc/rim/ml-activity/> .
@prefix mlm:   <https://w3id.org/ogc/stac/mlm/> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# Additive profile shapes: an mlact:MLActivity is still a rim:RegisterAction
# (the base shapes.shacl continues to apply — sh:targetClass follows
# rdfs:subClassOf, so rim:RegisterActionShape's constraints, including the
# required rim:actionType, also fire on these nodes). These shapes add the
# ML-specific requirements: a model, a task drawn from the closed MLM task
# list, and at least one typed input and output.

mlact:MLActivityShape a sh:NodeShape ;
    sh:targetClass mlact:MLActivity ;
    sh:property [
        sh:path mlact:model ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path mlact:performsTask ;
        sh:minCount 1 ;
        sh:in (
            mlm:regression mlm:classification mlm:scene-classification mlm:detection
            mlm:object-detection mlm:segmentation mlm:semantic-segmentation
            mlm:instance-segmentation mlm:panoptic-segmentation mlm:similarity-search
            mlm:generative mlm:image-captioning mlm:super-resolution mlm:downscaling
        ) ;
    ] ;
    sh:property [
        sh:path mlact:framework ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path mlact:accelerator ;
        sh:in (
            mlm:amd64 mlm:cuda mlm:xla mlm:amd-rocm mlm:intel-ipex-cpu mlm:intel-ipex-gpu mlm:macos-arm
        ) ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path mlact:input ;
        sh:class mlact:ActivityInput ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path mlact:output ;
        sh:class mlact:ActivityOutput ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path prov:startedAtTime ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path prov:endedAtTime ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] .

mlact:ActivityInputShape a sh:NodeShape ;
    sh:targetClass mlact:ActivityInput ;
    sh:property [
        sh:path dct:conformsTo ;
        sh:class mlm:ModelInput ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path mlact:structure ;
        sh:class mlm:InputStructure ;
        sh:maxCount 1 ;
    ] .

mlact:ActivityOutputShape a sh:NodeShape ;
    sh:targetClass mlact:ActivityOutput ;
    sh:property [
        sh:path dct:conformsTo ;
        sh:class mlm:ModelOutput ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path mlact:structure ;
        sh:class mlm:ResultStructure ;
        sh:maxCount 1 ;
    ] .
